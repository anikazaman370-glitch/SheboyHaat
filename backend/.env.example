PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# Auth sessions: access tokens are short-lived, refresh tokens last longer and
# are stored as httpOnly cookies so users stay logged in between visits.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# For production over HTTPS with a separate frontend domain, set:
# COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Neon PostgreSQL connection string (Project -> Connection Details -> Connection string).
# Keep ?sslmode=require so Prisma connects over TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Cloudinary (stores worker NID documents for admin verification).
# Get these from https://console.cloudinary.com -> Dashboard (Product Environment Credentials).
# The API secret stays on the server; it is never sent to the browser.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: folder inside your Cloudinary account where NIDs are stored.
CLOUDINARY_NID_FOLDER=sheboyhaat/nid
# Optional: API host. Defaults to api.cloudinary.com. EU-region accounts must use:
# CLOUDINARY_API_HOST=api-eu.cloudinary.com
CLOUDINARY_API_HOST=api.cloudinary.com
# Alternatively, paste the single CLOUDINARY_URL value instead of the three keys above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email OTP verification (sent when a customer or worker creates an account).
# Codes expire after OTP_TTL_MINUTES (default 5).
OTP_TTL_MINUTES=5

# --- SMS gateway (generic HTTP) ---
# Works with BulkSMSBD, Alpha SMS, SSLWireless and most local gateways.
# Placeholders you can use in the URL/body: {phone} {otp} {message} {apiKey}
# {senderId} {minutes}. Values are URL-encoded automatically.
# BulkSMSBD example:
# SMS_API_URL=https://bulksmsbd.net/api/smsapi?api_key={apiKey}&type=text&number={phone}&senderid={senderId}&message={message}
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_METHOD=GET
# For POST gateways, put the form fields here (or keep them after ? in SMS_API_URL).
# SMS_POST_BODY=api_key={apiKey}&senderid={senderId}&number={phone}&message={message}
# Set to false for JSON bodies so spaces/+ are not percent-encoded.
# SMS_BODY_ENCODE=true
# SMS_MESSAGE_TEMPLATE=SheboyHaat: Your verification code is {otp}. It expires in {minutes} minutes. Do not share this code with anyone.
# Extra headers as JSON, e.g. {"Authorization":"Bearer TOKEN"}.
# SMS_HEADERS={}
# Optional regex that a successful response must match, e.g. "success|202".
# SMS_SUCCESS_REGEX=

# Optional Twilio fallback (used only when SMS_API_URL is blank).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a Twilio phone number or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Email delivery for account verification codes.
# Registration verification codes are always sent by email, so configure these.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are blank the server prints the code to its
# console (development only).
MAIL_FROM="SheboyHaat <no-reply@sheboyhaat.com>"
SMTP_HOST=
SMTP_PORT=587
# Set SMTP_SECURE=true when using port 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
